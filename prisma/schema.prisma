// NagRaksha Prisma schema — emergency coordination domain.
// SQLite provider (per project constraint). No list primitives.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Incident {
  id          String   @id @default(cuid())
  token       String   @unique @default(cuid()) // bystander reference token
  lat         Float
  lng         Float
  address     String?
  biteTime    DateTime?
  bodyPart    String?
  snakeType   String? // suspected species
  state       String   @default("PENDING") // PENDING | DISPATCHING | ACCEPTED | TRANSPORTING | HANDED_OFF | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dispatchAttempts  DispatchAttempt[]
  symptomObservations SymptomObservation[]
  snakeObservations  SnakeObservation[]

  @@index([state])
  @@index([createdAt])
}

model DispatchAttempt {
  id           String   @id @default(cuid())
  incidentId   String
  category     String   // TRAINED | RESCUE | AMBULANCE
  candidateName String
  candidateRole String?
  distanceKm   Float?
  etaMin       Int?
  sentAt       DateTime @default(now())
  acceptedAt   DateTime?
  outcome      String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | ESCALATED | TIMED_OUT
  sequence     Int      @default(1)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([category])
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  address   String?
  contact   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  antivenomStock AntivenomStock[]
}

model AntivenomStock {
  id           String   @id @default(cuid())
  hospitalId   String
  product      String   // e.g. "Polyvalent ASV", "Big Four ASV"
  status       String   @default("UNKNOWN") // CONFIRMED | LOW | UNKNOWN | STALE | OUT
  quantityBand String?  // e.g. "10-50 vials"
  verifiedAt   DateTime @default(now())
  verifiedBy   String?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([status])
}

model SymptomObservation {
  id          String   @id @default(cuid())
  incidentId  String
  code        String   // e.g. LOCAL_PAIN, BLEEDING, PTOSIS
  label       String
  severity    String?  // MILD | MODERATE | SEVERE
  value       String?
  observedAt  DateTime @default(now())
  author      String?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model SnakeObservation {
  id              String   @id @default(cuid())
  incidentId      String
  imageRef        String?
  predictedClass  String?  // e.g. "Naja naja (Indian Cobra)"
  confidence      Float?    // 0..1
  venomType       String?   // NEUROTOXIC | HAEMOTOXIC | CYTOTOXIC | NON_VENOMOUS
  rescuerSpecies  String?
  createdAt       DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model RiskReport {
  id        String   @id @default(cuid())
  area      String
  lat       Float
  lng       Float
  level     String   // LOW | MODERATE | HIGH | SEVERE
  score     Int      // 0..100
  weather   String?  // summary text
  season    String?
  likelySnakes String? // comma-separated
  createdAt DateTime @default(now())
}

model MythThread {
  id        String   @id @default(cuid())
  question  String
  answer    String
  mythFlagged Boolean @default(false)
  createdAt DateTime @default(now())
}
