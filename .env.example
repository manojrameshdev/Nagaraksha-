# ── Database ─────────────────────────────────────────────────────────
# SQLite (default, no env var needed).
# For Postgres (production) uncomment and set:
# DATABASE_URL=postgresql://user:pass@host:5432/nagraksha

# ── LLM: Local GGUF ──────────────────────────────────────────────────
# Place any .gguf file in model/ — no API key needed.
# The backend auto-detects it on startup.

# ── LLM: Grok (xAI) — fallback if no GGUF model ─────────────────────
# Get your key at https://console.x.ai
# GROK_API_KEY=your_grok_api_key_here

# ── LLM: Gemini (Google) — secondary fallback ────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ─────────────────────────────────────────────────────────
# PGHOST=localhost
# PGPORT=5432
# PGUSER=nagraksha
# PGPASSWORD=
# PGDATABASE=nagraksha
