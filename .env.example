# ── Database & Realtime ───────────────────────────────────────────────
# SQLite primary (default, zero config needed for demo)
# Optional Supabase credentials:
# NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_KEY=your-supabase-service-key

# ── Backend & Deployment ─────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=nagraksha-demo-secret-change-in-prod
ROLE_SECRET_VICTIM=victim-demo
ROLE_SECRET_HOSPITAL=hospital-demo
ROLE_SECRET_ADMIN=admin-demo

# ── LLM & Vision APIs ────────────────────────────────────────────────
# Google Gemini (Gemini 2.5 Flash — Vision + RAG fallback)
# GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Llama-3 fast RAG response)
# GROQ_API_KEY=your_groq_api_key_here

# xAI Grok (Snake ID Vision fallback)
# GROK_API_KEY=your_grok_api_key_here

# ── Twilio Real SMS Dispatch ─────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+12015550123

# ── Sentry Error Monitoring ─────────────────────────────────────────
# SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx
