{
  "name": "NagRaksha — Snakebite Emergency Response",
  "short_name": "NagRaksha",
  "description": "Parallel-dispatch emergency response & prevention platform for snakebites in India. One SOS, three responders, antivenom-aware routing.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0A1812",
  "theme_color": "#0A1812",
  "categories": ["health", "medical", "utilities", "emergency"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Trigger SOS",
      "short_name": "SOS",
      "description": "Send an emergency snakebite SOS",
      "url": "/?action=sos",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Identify a Snake",
      "short_name": "Snake ID",
      "description": "Photo-classify a snake",
      "url": "/?action=snake-id",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
